@model Shop.Application.Products.DTOs.ProductDto
<h1>Delete Product</h1>

<h3>Are you sure you want to delete this product?</h3>

<div class="mb-3">
    <p><strong>Name:</strong> @Model.Name</p>
    <p><strong>Description:</strong> @Model.Description</p>
    <p><strong>Price:</strong> @Model.Price</p>
    <p><strong>Stock:</strong> @Model.StockQuantity</p>
</div>

<form asp-controller="Products" asp-action="DeleteConfirmed" method="post">
    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">Yes, Delete</button>

    <a asp-controller="Products" asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>