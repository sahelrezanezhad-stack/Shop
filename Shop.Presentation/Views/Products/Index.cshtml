@{
}
@model List<Shop.Application.Products.DTOs.ProductDto>
<h1>Products</h1>
<form asp-controller="Products" asp-action="Index" method="get" class="mb-3">
    <div class="input-group">
        <input type="text"
               name="search"
               value="@ViewBag.Search"
               class="form-control"
               placeholder="Search products by name..." />

        <button type="submit" class="btn btn-primary">
            Search
        </button>

        <a asp-controller="Products"
           asp-action="Index"
           class="btn btn-secondary">
            Clear
        </a>
    </div>
</form>

<p>
    <a href="/Products/Create">Add New Product</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Description</th>
            <th>Price</th>
            <th>Stock</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <td>@product.Id</td>
                <td>@product.Name</td>
                <td>@product.Description</td>
                <td>@product.Price</td>
                <td>@product.StockQuantity</td>
                <td>
                    <a href="/Products/Edit/@product.Id">Edit</a>

                    <a href="/Products/Delete/@product.Id" class="text-danger ms-2">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
