@{ Layout = "_AdminLayout"; ViewData["Title"] = "Products"; }
@model Shop.Application.Products.DTOs.UpdateProductDto
<div asp-validation-summary="All" class="admin-error"></div>
<h1>Edit Product</h1>

<form asp-controller="Products" asp-action="Edit" method="post">

    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="Price">Price (TOMAN)</label>
        <input asp-for="Price" class="form-control" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="StockQuantity"></label>
        <input asp-for="StockQuantity" class="form-control" readonly /><p class="admin-muted">Update available sizes in <a href="/admin/inventory">size inventory</a>.</p>
        <span asp-validation-for="StockQuantity" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>

    <a href="/Products" class="btn btn-secondary">Cancel</a>

</form>
