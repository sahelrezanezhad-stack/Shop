@model Shop.Presentation.Accounts.ResetPasswordInput
@{ ViewData["Title"] = "Choose a new password"; Layout = "_StoreLayout"; }
<main class="account-page"><a class="account-home" href="/">SALLY ✳</a><section class="account-card">
<span class="account-kicker">ACCOUNT RECOVERY</span><h1>Choose a new password</h1>
<div asp-validation-summary="All" class="account-error"></div>
<form asp-controller="Account" asp-action="ResetPassword" method="post">
<input asp-for="Id" type="hidden"/><input asp-for="Token" type="hidden"/>
<label>New password<input asp-for="Password" type="password" autocomplete="new-password" minlength="10" maxlength="128" required /></label>
<label>Confirm password<input asp-for="ConfirmPassword" type="password" autocomplete="new-password" minlength="10" maxlength="128" required /></label>
<button class="account-submit" type="submit">CHANGE PASSWORD</button></form>
<p><a href="/account/forgot-password">Request a new link</a></p></section></main>
