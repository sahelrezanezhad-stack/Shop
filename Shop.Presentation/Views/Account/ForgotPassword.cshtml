@model Shop.Presentation.Accounts.ForgotPasswordInput
@{ ViewData["Title"] = "Reset password"; Layout = "_StoreLayout"; }
<main class="account-page"><a class="account-home" href="/">SALLY ✳</a><section class="account-card">
<span class="account-kicker">ACCOUNT RECOVERY</span><h1>Forgot your password?</h1>
<p>Enter your verified email address to request a password reset link.</p>
@if (ViewData["notice"] is string notice) { <p class="account-note" role="status">@notice</p> }
<div asp-validation-summary="All" class="account-error"></div>
<form asp-controller="Account" asp-action="ForgotPassword" method="post">
<label>Email address<input asp-for="Email" type="email" autocomplete="email" required maxlength="256" /></label>
<button class="account-submit" type="submit">SEND RESET LINK</button></form>
<p><a href="/account/login">Back to sign in</a></p></section></main>
