@model IReadOnlyList<Shop.Application.ShoppingCarts.ManagedStockProduct>
@{ ViewData["Title"] = "Size inventory"; Layout = "_AdminLayout"; }
<span class="account-kicker">INVENTORY MANAGEMENT</span><h1>Size inventory</h1>
<p class="admin-muted">Set the available quantity for each size. The product total is calculated from these quantities.</p>
@foreach(var product in Model){<section class="admin-card" style="margin-bottom:22px"><h2>@product.Name</h2><p class="admin-muted">Current total: @product.Total · Product #@product.Id</p>
<form action="/admin/inventory/@product.Id" method="post">@Html.AntiForgeryToken()<input type="hidden" name="ExpectedTotal" value="@product.Total"/>
<div class="admin-stock-grid">@for(var i=0;i<product.Sizes.Count;i++){var stock=product.Sizes[i];<label>@stock.Size<input type="hidden" name="Entries[@i].Size" value="@stock.Size"/><input type="hidden" name="Entries[@i].ExpectedQuantity" value="@stock.Quantity"/><input type="number" name="Entries[@i].Quantity" value="@stock.Quantity" min="0" max="100000" required/></label>}</div>
<button type="submit" class="btn">SAVE INVENTORY</button></form></section>}
@if(Model.Count==0){<p>No approved collection products were found in the database.</p>}
